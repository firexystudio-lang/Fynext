{
  "name": "@mfiretech/fynext",
  "version": "1.0.0",
  "description": "Fynext - local LLM-powered coding agent for the terminal",
  "type": "commonjs",
  "main": "src/cli/main.js",
  "bin": {
    "fynext": "bin/fynext.js"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "sounds/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/fynext.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-llama-cpp": "3.22.2",
    "serialport": "^12.0.0"
  },
  "overrides": {
    "node-llama-cpp": {
      "simple-git": "4.0.2"
    }
  },
  "license": "MIT",
  "allowScripts": {
    "node-llama-cpp@3.22.2": true,
    "@serialport/bindings-cpp@12.0.1": true
  }
}
